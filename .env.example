TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
APP_KEY=
NODE_ENV=development
SESSION_DRIVER=cookie

# Public origin (Better Auth + Khaime redirect/return URLs)
APP_URL=http://localhost:3333

# Khaime — managed payouts (optional; mock rail is used if unset)
KHAIME_API_KEY=
KHAIME_API_URL=https://api.khaime.com/api/v1
KHAIME_WEBHOOK_SECRET=
KHAIME_COMMISSION_RATE=0.05

# Brevo — transactional email (verification + password reset).
# If BREVO_API_KEY or MAIL_FROM_EMAIL is unset, emails are logged, not sent.
# MAIL_FROM_EMAIL must be a verified sender/domain in your Brevo account.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Show Me Love
