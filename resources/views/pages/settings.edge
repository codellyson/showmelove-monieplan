<!DOCTYPE html>
<html lang="en">
<head>
  @include('partials/head')
</head>
<body data-brand-save="1">
  <div class="page">
    <div class="dash">
      @include('partials/sidebar')
      <main class="main">
        <div class="settings-wrap">

      <h1 class="settings-title">Settings</h1>
      <p class="settings-sub">Update your page details — changes go live immediately.</p>

      @if(saved)
      <div class="flash flash-ok">{{ saved }}</div>
      @end
      @if(error)
      <div class="flash flash-err">{{ error }}</div>
      @end

      <form method="POST" action="/settings" class="settings-card">
        {{ csrfField() }}

        <label class="field-label">Display name</label>
        <input class="text-input" name="displayName" value="{{ creator.displayName }}" required>

        <label class="field-label" style="margin-top:18px;">Your link</label>
        <div class="link-input">
          <span class="link-prefix">{{ siteHost }}/</span>
          <input class="link-handle" name="handle" value="{{ creator.handle }}" required>
        </div>

        <label class="field-label" style="margin-top:18px;">Short bio</label>
        <textarea class="textarea" name="bio" rows="3" maxlength="280">{{ creator.bio || '' }}</textarea>

        <div class="field-row">
          <div class="field-col">
            <label class="field-label">Currency</label>
            <select class="select" name="currency">
              @each(c in currencies)
              <option value="{{ c }}" {{ creator.currency === c ? 'selected' : '' }}>{{ c }}</option>
              @end
            </select>
          </div>
          <div class="field-col">
            <label class="field-label">Monthly goal</label>
            <input class="text-input" name="monthlyGoal" inputmode="numeric" value="{{ creator.monthlyGoal }}">
          </div>
        </div>

        <label class="field-label" style="margin-top:18px;">Brand color</label>
        <div class="brand-swatches">
          @each(p in palette)
          <label class="brand-swatch-opt">
            <input type="radio" name="brandColor" value="{{ p }}" {{ creator.brandColor === p ? 'checked' : '' }}>
            <span style="background:{{ p }};"></span>
          </label>
          @end
        </div>

        <div class="settings-payout">
          Payout mode: <b>{{ creator.payoutMode === 'byo' ? 'Bring-your-own (0% fee)' : 'Managed payouts' }}</b>
          · <a href="/connect">manage payouts</a>
        </div>

        <button class="btn-primary settings-save" type="submit">Save changes</button>
      </form>

        </div>
      </main>
    </div>
  </div>
</body>
</html>
