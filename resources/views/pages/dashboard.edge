<!DOCTYPE html>
<html lang="en">
<head>
  @include('partials/head')
</head>
<body data-brand-save="1">
  <div class="page">
    <div class="dash">

      <!-- SIDEBAR -->
      <aside class="side">
        <a class="side-brand brand" href="/">
          <div class="brand-mark">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#fff"><path d="M12 21s-7-4.5-9.5-9C1 9 2.5 5.5 6 5.5c2 0 3.2 1.3 4 2.5.8-1.2 2-2.5 4-2.5 3.5 0 5 3.5 3.5 6.5C19 16.5 12 21 12 21Z"/></svg>
          </div>
          <span class="brand-name" style="font-size:19px;">showmelove</span>
        </a>
        <nav class="side-nav">
          <div class="nav-item is-active">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
            <span>Home</span>
          </div>
          <div class="nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A7F6B" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg>
            <span>Supporters</span>
          </div>
          <a class="nav-item" href="/payouts">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A7F6B" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
            <span>Payouts</span>
          </a>
          <a class="nav-item" href="/settings">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A7F6B" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-2.82 1.17V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 7.6 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 3 15.6a1.65 1.65 0 0 0-1.51-1H1a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 3 8.6a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 8.4 3h.09A1.65 1.65 0 0 0 10 1.51V1a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1.51 1.51"/></svg>
            <span>Settings</span>
          </a>
        </nav>
        <div class="side-spacer"></div>
        <div class="side-user">
          <div class="avatar" style="width:38px;height:38px;background:var(--brand);font-size:14px;">{{ v.creator.displayName.charAt(0).toUpperCase() }}</div>
          <div style="min-width:0;flex:1;">
            <div class="side-user-name">{{ v.creator.displayName }}</div>
            <div class="side-user-handle">{{ '@' + v.creator.handle }}</div>
          </div>
          <form method="POST" action="/logout">
            {{ csrfField() }}
            <button type="submit" class="side-signout" title="Sign out" aria-label="Sign out">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A7F6B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
            </button>
          </form>
        </div>
      </aside>

      <!-- MAIN -->
      <main class="main">
        <div class="main-head">
          <div>
            <div class="welcome-row">
              <div class="welcome">Welcome back, {{ v.creator.displayName.split(' ')[0] }}</div>
              @if(ui.showBadge)
              <span class="head-badge">Own processor · keep 100%</span>
              @end
            </div>
            <div class="welcome-sub">
              @if(v.isEmpty)
              Your page is live — share it to collect your first love note.
              @else
              You got <span class="accent">{{ v.notes.length }} new love notes</span> this week.
              @end
            </div>
          </div>
          <div class="link-bar">
            <span class="link-bar-url">showmelove.com/{{ v.creator.handle }}</span>
            <button class="copy-btn" id="copyBtn" data-url="https://showmelove.com/{{ v.creator.handle }}">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
              <span id="copyLabel">Copy link</span>
            </button>
          </div>
        </div>

        <!-- Preview the PRD's three dashboard variants (server-driven via ?state=) -->
        <div class="dash-variants">
          <span class="dash-variants-label">View:</span>
          <a href="/dashboard?state=managed" class="{{ activeVariant === 'managed' ? 'is-on' : '' }}">Managed</a>
          <a href="/dashboard?state=empty" class="{{ activeVariant === 'empty' ? 'is-on' : '' }}">Empty (new)</a>
          <a href="/dashboard?state=byo" class="{{ activeVariant === 'byo' ? 'is-on' : '' }}">Bring-your-own</a>
        </div>

        <!-- METRICS -->
        <div class="metrics">
          <div class="metric">
            <div class="metric-label">Total raised</div>
            <div class="metric-value">{{ v.raisedLabel }}</div>
            <div class="metric-delta {{ v.totalDeltaUp ? '' : 'is-down' }}">
              @if(v.isEmpty)
              No support yet
              @else
              {{ v.totalDeltaLabel }}
              @end
            </div>
          </div>
          <div class="metric">
            <div class="metric-label">Supporters</div>
            <div class="metric-value">{{ v.supporters }}</div>
            <div class="metric-delta {{ v.supportersDeltaUp ? '' : 'is-down' }}">
              @if(v.isEmpty)
              Share your link to begin
              @else
              {{ v.supportersDeltaLabel }}
              @end
            </div>
          </div>
          <div class="metric metric-goal">
            <div class="goal-head">
              <span class="goal-label">Monthly goal</span>
              <span class="goal-fig"><b>{{ v.raisedShort }}</b> <span class="goal-of">/ {{ v.goalShort }}</span></span>
            </div>
            <div class="goal-track"><div class="bar-fill" style="width:{{ v.goalPct }}%;"></div></div>
            <div class="goal-note">{{ v.remainingLabel }} to reach your goal</div>
          </div>
        </div>

        <!-- LOWER GRID -->
        <div class="lower">
          <!-- LOVE NOTES -->
          <div class="notes-panel">
            <div class="notes-head">
              <span class="notes-title">Recent love notes</span>
              <span class="notes-seeall">See all</span>
            </div>
            @if(v.isEmpty)
            <div class="notes-empty">
              <div class="notes-empty-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="var(--brand)"><path d="M12 21s-7-4.5-9.5-9C1 9 2.5 5.5 6 5.5c2 0 3.2 1.3 4 2.5.8-1.2 2-2.5 4-2.5 3.5 0 5 3.5 3.5 6.5C19 16.5 12 21 12 21Z"/></svg>
              </div>
              <div class="notes-empty-title">No love notes yet</div>
              <div class="notes-empty-sub">Share your link to get your first one.</div>
            </div>
            @else
            @each(note in v.notes)
            <div class="note">
              <div class="avatar" style="width:40px;height:40px;font-size:15px;background:{{ note.color }};">{{ note.initial }}</div>
              <div style="flex:1;min-width:0;">
                <div class="note-name">{{ note.name }}</div>
                @if(note.message)
                <div class="note-quote">“{{ note.message }}”</div>
                @end
              </div>
              <div class="note-right">
                <div class="note-amount">{{ note.amountLabel }}</div>
                <div class="note-time">{{ note.timeAgo }}</div>
              </div>
            </div>
            @end
            @end
          </div>

          <!-- UPGRADE NUDGE -->
          @if(ui.showNudge)
          <div class="nudge" id="nudge">
            <button class="nudge-close" id="nudgeClose" aria-label="Dismiss">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#9A8F7C" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
            <div class="nudge-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z"/></svg>
            </div>
            <div class="nudge-title">Keep 100% of your love</div>
            <div class="nudge-body">You're growing fast. Connect your own Paystack or Stripe and we'll stop taking a fee — page, link, and supporters stay exactly as they are.</div>
            <a class="nudge-cta" href="/connect">Connect a processor</a>
            <div class="nudge-foot">You can switch anytime.</div>
          </div>
          @end
        </div>
      </main>

    </div>
  </div>
  <script src="/assets/dashboard.js"></script>
</body>
</html>
