<!DOCTYPE html>
<html lang="en">
<head>
  @include('partials/head')
</head>
<body data-brand-save="1">
  <div class="page">
    <div class="dash">
      @include('partials/sidebar')
      <main class="main">
        <div class="payouts-wrap">

      <h1 class="payouts-title">Payouts</h1>

      @if(saved)
      <div class="flash flash-ok">{{ saved }}</div>
      @end
      @if(error)
      <div class="flash flash-err">{{ error }}</div>
      @end
      @if(stripeDone)
      <div class="flash flash-ok">Thanks — we're finalizing your USD payout account.</div>
      @end

      @if(isManaged)
      <!-- ===== MANAGED PAYOUTS ===== -->

      <div class="balance-card">
        <div class="balance-label">Available to pay out</div>
        <div class="balance-value">{{ netLabel }}</div>
        <div class="balance-sub">{{ grossLabel }} received · after a {{ commissionPct }}% platform fee</div>
      </div>

      @if(!khaimeConfigured)
      <div class="note-card">Managed payouts aren't enabled in this environment yet — the flow below is wired and ready once it's configured.</div>
      @end

      <!-- How you get paid -->
      <div class="panel">
        <div class="panel-head">
          <span class="panel-title">How you get paid</span>
          @if(payoutStatus === 'ready')
          <span class="kyc-badge is-ok">connected{{ settlementCurrency ? ' · ' + settlementCurrency : '' }}</span>
          @elseif(payoutStatus === 'action_needed')
          <span class="kyc-badge is-warn">action needed</span>
          @elseif(payoutStatus === 'pending')
          <span class="kyc-badge is-pending">verifying…</span>
          @end
        </div>

        @if(payoutStatus === 'ready')
        <p class="panel-note is-ok">✓ You're all set — {{ payoutMethod === 'bank' ? 'paid straight to your local bank' : creator.currency + ' payouts are set up' }}{{ settlementCurrency ? ', settling in ' + settlementCurrency : '' }}. You can withdraw below.</p>
        <details class="update-method">
          <summary>Update payout details</summary>
          @include('partials/payout_method_form')
        </details>
        @else
          @if(payoutStatus === 'pending')
          <p class="panel-note">We've received your details and are verifying them. This can take a few minutes; we'll mark this <b>connected</b> once it's done. Refresh to check.</p>
          @elseif(payoutStatus === 'action_needed')
          <p class="panel-note">We need a little more information before your payouts can go live. {{ payoutMethod === 'bank' ? 'Re-check your bank details below.' : 'Continue the setup below.' }}</p>
          @elseif(payoutMethod === 'bank')
          <p class="panel-note">You earn in <b>{{ sym }} {{ creator.currency }}</b>, so you're paid straight to your local bank. Enter your details and we'll verify and set everything up.</p>
          @else
          <p class="panel-note">You earn in <b>{{ sym }} {{ creator.currency }}</b>, so you're paid into a secure payout account. You'll be redirected to a short, one-time setup — we handle the rest.</p>
          @end
          @include('partials/payout_method_form')
        @end
      </div>

      <!-- Withdraw -->
      <div class="panel">
        <div class="panel-head">
          <span class="panel-title">Withdraw</span>
          @if(!payoutReady)
          <span class="kyc-badge">add a method first</span>
          @end
        </div>
        @if(payoutReady)
        <p class="panel-note">Move money from your wallet to your payout account. Requests are reviewed before settlement.</p>
        <form method="POST" action="/payouts/request" class="payout-request">
          {{ csrfField() }}
          <div class="amount-field">
            <span class="amount-sym">{{ sym }}</span>
            <input class="text-input" name="amount" inputmode="numeric" placeholder="0">
          </div>
          <button class="btn-primary" type="submit">Request payout</button>
        </form>
        @else
        <p class="panel-note">Set up a payout method above, then you can withdraw here.</p>
        @end
      </div>

      <div class="payouts-foot">Prefer to keep 100%? <a href="/connect">Bring your own processor</a> instead.</div>

      @else
      <!-- ===== BRING-YOUR-OWN ===== -->
      <div class="balance-card">
        <div class="balance-label">Bring-your-own</div>
        <div class="balance-value">{{ grossLabel }}</div>
        <div class="balance-sub">You keep 100%. Support settles through your own {{ creator.processor === 'stripe' ? 'Stripe' : 'Paystack' }} account — showmelove doesn't hold your funds.</div>
      </div>
      <div class="panel">
        <div class="panel-head"><span class="panel-title">Your processor</span></div>
        <p class="panel-note">Payouts are handled by your connected processor. Manage or switch it on the connect page.</p>
        <a class="btn-primary" href="/connect" style="display:inline-flex;align-items:center;">Manage processor</a>
      </div>
      <div class="payouts-foot">Want us to handle settlement instead? <a href="/connect">Switch to managed payouts</a>.</div>
      @end

        </div>
      </main>
    </div>
  </div>
</body>
</html>
